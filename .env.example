# ══════════════════════════════════════════════════════════════
#  DAR PLUS — Exemple de configuration
#  Copiez ce fichier en .env et renseignez vos vraies valeurs
# ══════════════════════════════════════════════════════════════

# ── Firebase ────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID_WEB=your_web_app_id_here
FIREBASE_APP_ID_ANDROID=your_android_app_id_here
FIREBASE_APP_ID_IOS=your_ios_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# ── EmailJS ─────────────────────────────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key_here

# ── Application ─────────────────────────────────────────────────
APP_NAME=DAR PLUS
APP_ENV=production

# ── Compte Super Admin de secours (accès d'urgence) ─────────────
ADMIN_ROOT_EMAIL=admin@darplus.tn
ADMIN_ROOT_PASSWORD=your_admin_password_here
ADMIN_ROOT_FALLBACK_PASSWORD=your_fallback_password_here
