rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() in ['admin', 'super_admin'];
    }

    function isPro() {
      return isSignedIn() && getUserRole() == 'professionnel';
    }

    function isClient() {
      return isSignedIn() && getUserRole() == 'client';
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Chaque utilisateur peut lire/écrire son propre document.
    // Les admins peuvent lire tous les utilisateurs.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sous-collection favoris : accessible uniquement par le propriétaire
      match /favorites/{favId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── bookings ──────────────────────────────────────────────────────────────
    // - Le client peut créer et lire ses propres réservations
    // - Le pro peut lire et mettre à jour les réservations qui lui sont assignées
    // - L'admin peut tout lire
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId    == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId    == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Chaque utilisateur lit/modifie uniquement ses propres notifications.
    // Le système (Firebase Functions ou app authentifiée) peut créer.
    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ── categories ────────────────────────────────────────────────────────────
    // Lecture publique (pour afficher dans le catalogue).
    // Écriture réservée aux admins.
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── pro_applications ─────────────────────────────────────────────────────
    // Le pro peut créer et lire sa propre demande.
    // L'admin peut tout lire/modifier.
    match /pro_applications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── reviews ───────────────────────────────────────────────────────────────
    // Lecture publique. Écriture par clients connectés uniquement.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isClient();
      allow update, delete: if isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    // ── security_logs ─────────────────────────────────────────────────────────
    // Lecture réservée aux admins. Écriture par l'app authentifiée.
    match /security_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if isSignedIn();
    }
  }
}
