rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    //  RÈGLES FIRESTORE — DAR PLUS
    //  Règle principale : tout utilisateur authentifié peut lire et écrire.
    //  Simple, sans dépendances circulaires. Adapté au développement.
    // ══════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
